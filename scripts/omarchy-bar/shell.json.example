{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "io.github.majesticio.cliamped"
        },
        {
          "id": "luisreche.pomodoro"
        },
        {
          "id": "omarchy.microphone"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "io.github.andressm415.omaprox"
        },
        {
          "id": "io.github.inxeo.plexamp-simple-player"
        },
        {
          "id": "meviusisback.hw-monitor"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "hermes",
          "type": "qml",
          "source": "~/.config/omarchy/bar/modules/Hermes.qml"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "io.github.ok.omakoe"
    },
    {
      "id": "rblalock.grid-wallpaper-picker"
    },
    {
      "id": "io.github.elvis-christian.homelab-launcher"
    }
  ],
  "version": 1
}
